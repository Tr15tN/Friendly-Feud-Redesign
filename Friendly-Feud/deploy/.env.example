# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=m0usetrap.ee

# Host password for the /admin console. Use something long.
ADMIN_CONSOLE_PASSWORD=change-me
# Signs admin login cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-secret

# Abuse protection for a public server.
MAX_ROOMS=50
ROOM_CREATE_LIMIT_PER_HOUR=10

# Image tag produced by deploy/ship.sh
FEUD_IMAGE=famf-feud:latest
