# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically.
# It also sets X-Forwarded-For to the real client address (used for the per-IP room limit)
# and replaces any value the client tried to send.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy feud:80
}

# www.<domain> goes to the main address.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
