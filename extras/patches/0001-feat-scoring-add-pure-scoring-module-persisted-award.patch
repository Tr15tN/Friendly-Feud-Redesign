@@ -63,6 +71,8 @@ type finalRound struct {
 	Points    int    `json:"points"`
 	Input     string `json:"input"`
 	Revealed  bool   `json:"revealed"`
+	// Host pressed "Award" for this answer.
+	Awarded bool `json:"awarded,omitempty"`
 }
 
