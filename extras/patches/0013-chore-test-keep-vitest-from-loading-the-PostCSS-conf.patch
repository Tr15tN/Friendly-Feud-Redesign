Date: Sun, 18 Oct 2026 18:49:26 +0300
Subject: [PATCH 13/18] chore(test): keep vitest from loading the PostCSS
 config

---
 vitest.config.mts | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/vitest.config.mts b/vitest.config.mts
index 9f48e73..f89f505 100644
--- a/vitest.config.mts
+++ b/vitest.config.mts
@@ -2,9 +2,10 @@ import { defineConfig } from "vitest/config";
 
 // Unit tests only; Playwright e2e specs live in ./e2e and are run separately.
 export default defineConfig({
+  // Skip loading the app's PostCSS/Tailwind config; unit tests don't touch CSS.
+  css: { postcss: { plugins: [] } },
   test: {
     include: ["src/**/*.test.ts"],
     environment: "node",
-    css: false,
   },
 });
