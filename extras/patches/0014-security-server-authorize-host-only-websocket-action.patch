@@ -32,7 +33,14 @@ func LoadGame(client *Client, event *Event) GameError {
 	gameBytes, err := json.Marshal(event.Data)
 	loadedGame := game{}
 	if event.File != "" {
-		filePath := filepath.Join(event.File)
+		// Only built-in game definitions under games/ may be read from disk.
+		// Without this a host could point File at any file on the server
+		// (e.g. games/../../etc/passwd) and read it back through the game state.
