+// hostPassword returns the secret that authorizes host-only actions in a room.
+// It is the only thing separating a host from a player, so it must be long and
+// unguessable: 24 random bytes from a cryptographic source (~192 bits), encoded
+// without any ":" so it survives the "room:id:password" session cookie format.
 func hostPassword() string {
-	var passwordLength = 6
-	var passwordCharacters = []rune("123456789abcdefghijklmnopqrstuvwxyz")
-	b := make([]rune, passwordLength)
-	for i := range b {
-		b[i] = passwordCharacters[rand.Intn(len(passwordCharacters))]
+	b := make([]byte, 24)
+	if _, err := crand.Read(b); err != nil {
+		// Fall back to the (weaker) math/rand source rather than returning an
+		// empty password, which would disable host auth entirely.
+		var passwordCharacters = []rune("123456789abcdefghijklmnopqrstuvwxyz")
+		r := make([]rune, 24)
+		for i := range r {
+			r[i] = passwordCharacters[rand.Intn(len(passwordCharacters))]
+		}
+		return string(r)
 	}
-	return string(b)
+	return base64.RawURLEncoding.EncodeToString(b)
 }
 
 // pingInterval Send a ping message every 5 seconds on a player
