 }
+
+// hostPasswordMatches reports whether the supplied password equals the room's
+// host password. A room with no host password (not yet hosted) never matches.
+// The comparison is constant-time to avoid leaking the password by timing.
+func hostPasswordMatches(room *room, provided string) bool {
+	if room == nil || room.HostPassword == "" {
+		return false
+	}
+	return subtle.ConstantTimeCompare([]byte(room.HostPassword), []byte(provided)) == 1
+}
+
+// clientOwnsID reports whether the websocket connection making a request is the
+// one registered for the given player id. Player ids are broadcast to every
+// client inside the game data, so self-only actions (buzz, register, convert to
+// spectator) must verify ownership instead of trusting the id in the message.
+func clientOwnsID(room *room, id string, client *Client) bool {
+	if room == nil || id == "" {
+		return false
+	}
+	room.ensureMu()
+	room.mu.RLock()
+	registered, ok := room.registeredClients[id]
+	room.mu.RUnlock()
+	if !ok || registered == nil {
+		return false
+	}
+	return registered.client == client
+}
