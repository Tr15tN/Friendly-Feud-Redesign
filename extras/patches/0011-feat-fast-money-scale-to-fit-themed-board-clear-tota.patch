+  const apply = (rounds: FinalRound[]) => rounds.map((round, index) => (index === i ? update(round) : round));
+  return prev.is_final_second
+    ? { ...prev, final_round_2: apply(prev.final_round_2) }
+    : { ...prev, final_round: apply(prev.final_round) };
