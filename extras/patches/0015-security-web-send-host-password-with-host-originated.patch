From 290026566f420fc65fb348d24e154ab9cdd928e6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tristan=20M=C3=B5ts?= <tristan@localhost>
Date: Sun, 18 Oct 2026 19:08:47 +0300
Subject: [PATCH 15/18] security(web): send host password with host-originated
 control messages

The host teardown (quit) and the game window's timer_complete and
title_music_playback_error messages now carry the room host password so they
pass the server's new host authorization, while spectators (session :0) cannot.
---
 src/pages/game.tsx  | 6 ++++--
 src/pages/index.tsx | 2 ++
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/pages/game.tsx b/src/pages/game.tsx
index b7b107e..5bf82ad 100644
--- a/src/pages/game.tsx
+++ b/src/pages/game.tsx
@@ -52,7 +52,7 @@ export default function GamePage() {
 
   const notifyTitleMusicPlaybackError = () => {
     const session = cookieCutter.get("session");
-    const [room, id] = session?.split(":") ?? [];
+    const [room, id, hostPassword] = session?.split(":") ?? [];
 
     if (!room || !id || ws.current?.readyState !== WebSocket.OPEN) {
       return;
@@ -63,6 +63,7 @@ export default function GamePage() {
         action: WSAction.TITLE_MUSIC_PLAYBACK_ERROR,
         room,
         id,
+        hostPassword,
       })
     );
   };
@@ -248,7 +249,7 @@ export default function GamePage() {
               // Send timer stop to admin.js
               try {
                 const session = cookieCutter.get("session");
-                const [room, id] = session.split(":");
+                const [room, id, hostPassword] = session.split(":");
 
                 if (!session) {
                   console.error("No session cookie found");
@@ -266,6 +267,7 @@ export default function GamePage() {
                       action: "timer_complete",
                       room: room,
                       id: id,
+                      hostPassword: hostPassword,
                     })
                   );
                 } else {
diff --git a/src/pages/index.tsx b/src/pages/index.tsx
index 1c3e32d..c248133 100644
--- a/src/pages/index.tsx
+++ b/src/pages/index.tsx
@@ -66,6 +66,8 @@ export default function Home() {
           host: host,
           id: playerID,
           room: registeredRoomCode,
+          // Required so the server authorizes a host tearing down the room.
+          hostPassword: host ? hostPassword : undefined,
         })
       );
     } else {
-- 
