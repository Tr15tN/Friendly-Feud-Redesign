 src/global.css                  | 41 +++++++++++++++++++++
 src/lib/hooks/useCountUp.ts     | 63 +++++++++++++++++++++++++++++++++
 3 files changed, 120 insertions(+), 2 deletions(-)
 create mode 100644 src/lib/hooks/useCountUp.ts

